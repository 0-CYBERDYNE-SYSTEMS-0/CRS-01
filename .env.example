# =============================================================================
# CRS-01 — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# OpenAI — optional; enables LLM-assisted lineage extraction in the research
# pipeline (read via os.environ, not settings). Without it the regex
# extractor runs alone.
OPENAI_API_KEY=sk-...

# Source durability: when true, each research merge checks archive.org for
# existing captures of up to 10 new source URLs (4s timeout each) and
# records hits on the sources rows. Default OFF — the merge path makes no
# network calls unless you opt in. POST /archive/lookup works either way.
CRS_WAYBACK_AUTOLOOKUP=false

# FastAPI
# CORS_ORIGINS must list BOTH `localhost` and `127.0.0.1` variants — browsers
# treat them as different origins, and FastAPI CORS is exact-match, not
# suffix-match. Add 3030 if you dev on a non-default port.
# Pydantic-settings v2 requires JSON array syntax in .env files for List[str]
# fields, not comma-separated. Keep the quotes.
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:8000"]
API_TITLE=CRS-01 API
API_VERSION=0.1.0

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
